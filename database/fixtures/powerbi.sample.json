        ],
        "measures": [
         {
          "name": "Fatturato Totale",
          "expression": "SUM(Vendite[Importo])",
          "isHidden": false,
          "formatString": "#,0 €"
         },
         {
          "name": "Fatturato AP",
          "expression": "CALCULATE([Fatturato Totale], SAMEPERIODLASTYEAR(Calendario[Data]))",
          "isHidden": false,
          "formatString": "#,0 €"
         },
         {
          "name": "Fatturato YoY %",
          "expression": "DIVIDE([Fatturato Totale]-[Fatturato AP],[Fatturato AP])",
          "isHidden": false,
          "formatString": "0.0%"
         },
         {
          "name": "Quantità Venduta",
          "expression": "SUM(Vendite[Quantita])",
          "isHidden": false
         },
         {
          "name": "Margine %",
          "expression": "DIVIDE([Fatturato Totale]-SUM(Vendite[Costo]),[Fatturato Totale])",
          "isHidden": false,
          "formatString": "0.0%",
          "description": "Margine lordo su fatturato"
         },
         {
          "name": "Budget Fatturato",
          "expression": "SUM(Budget[Valore])",
          "isHidden": false,
          "formatString": "#,0 €"
         },
         {
          "name": "Scostamento Budget %",
          "expression": "DIVIDE([Fatturato Totale]-[Budget Fatturato],[Budget Fatturato])",
          "isHidden": false,
          "formatString": "0.0%"
         }
        ],
        "isHidden": false,
        "source": [
         {
          "expression": "let Origine = Sql.Database(\"dwh.azienda.local\", \"DWH\"), Vendite = Origine{[Schema=\"sales\",Item=\"FactSales\"]}[Data] in Vendite"
